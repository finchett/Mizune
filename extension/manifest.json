{
  "manifest_version": 3,
  "name": "Mizune",
  "description": "Look words up in Japanese subtitles and add them to Anki, on Netflix, Crunchyroll and other sites. Works with the Mizune app, or on its own.",
  "homepage_url": "https://mizune.app",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Mizune",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "commands": {
    "toggle": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Turn Mizune on or off for this tab"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "*://*.netflix.com/*",
    "*://*.nflxvideo.net/*",
    "*://*.crunchyroll.com/*",
    "*://*.youtube.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "https://github.com/*",
    "https://*.githubusercontent.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.netflix.com/*",
        "*://*.crunchyroll.com/*",
        "*://*.youtube.com/*"
      ],
      "js": [
        "page.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.netflix.com/*",
        "*://*.crunchyroll.com/*",
        "*://*.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "chrome": {
    "key": "",
    "minimum_chrome_version": "116",
    "sandbox": {
      "pages": [
        "card.html"
      ]
    },
    "background": {
      "service_worker": "background.js"
    },
    "permissions": [
      "tabCapture",
      "offscreen"
    ]
  },
  "firefox": {
    "background": {
      "scripts": [
        "background.js"
      ]
    },
    "host_permissions": [
      "https://github.com/*",
      "https://*.githubusercontent.com/*"
    ],
    "browser_specific_settings": {
      "gecko": {
        "id": "extension@mizune.app",
        "strict_min_version": "128.0",
        "data_collection_permissions": {
          "required": ["none"]
        }
      }
    }
  }
}
